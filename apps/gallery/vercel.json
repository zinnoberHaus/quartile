{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/examples", "permanent": false },
    { "source": "/language", "destination": "/examples/playground", "permanent": false },
    { "source": "/studio", "destination": "/examples/studio", "permanent": false },
    { "source": "/embed/:path*", "destination": "/examples/embed/:path*", "permanent": false },
    { "source": "/starter/:path*", "destination": "/examples/starter/:path*", "permanent": false }
  ],
  "rewrites": [{ "source": "/examples/((?!_assets/|embed/|starter/).*)", "destination": "/index" }]
}
