{
  "name": "quartile-monorepo",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @quartile/react build && pnpm --filter @quartile/gallery build",
    "build:lib": "pnpm --filter @quartile/react build",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "pnpm --filter @quartile/gallery dev",
    "test": "pnpm --filter @quartile/react test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
